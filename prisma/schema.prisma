datasource db {
  provider  = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum LeadStatus {
  NEW          // Новая заявка
  IN_PROGRESS  // В работе
  ESTIMATE     // Смета/Замер
  PROCESSED    // В производстве (предоплата)
  COMPLETED    // Выполнен (оплачен полностью)
  CANCELLED    // Отказ
  UNPROCESSED  // Не отработан (упущенный лид)
}

enum TransactionType {
  INCOME
  EXPENSE_COMPANY
  WITHDRAWAL_PARTNER
  TRANSFER_BETWEEN_ACCOUNTS
}

enum AccountType {
  BANK_CHECKING
  KASPI_PAY
  CASH_OFFICE
  PETTY_CASH
  SAFE
}

enum CategoryType {
  INCOME
  EXPENSE_DIRECT
  EXPENSE_OVERHEAD
  EXPENSE_COMMERCIAL
  EXPENSE_TAX
  WITHDRAWAL
}

enum PartnerName {
  DANIIL
  ELISEY
}

enum ClientRating {
  EASY        // "Легкий в общении / Адекватный" 🟢
  STANDARD    // "Обычный / Стандартный" 🟡
  PROBLEM     // "Сложный / Требовательный" 🔴
}

enum FileCategory {
  MEASUREMENT // Фото замеров / объекта
  SKETCH      // Эскизы / Макеты / Дизайн-код
  CONTRACT    // Договоры и приложения
  INVOICE     // Счета на оплату / Акт выполненных работ
  OTHER       // Прочее
}

enum ProjectStatus {
  PLANNING     // Планируется
  IN_PROGRESS  // В работе
  COMPLETED    // Завершен
  ON_HOLD      // На паузе
}

enum TaskStatus {
  TODO         // К выполнению
  IN_PROGRESS  // В процессе
  DONE         // Выполнено
  CANCELLED    // Отменено
}

enum TaskPriority {
  URGENT       // 🔥 Горит / Срочно
  HIGH         // ⚠️ Высокий
  NORMAL       // 🟡 Обычный
  LOW          // 🟢 Низкий
}

enum TaskStage {
  MEASUREMENT  // 📐 Замер и осмотр объекта
  SUPPLY       // 🛒 Закупка сырья и светотехники
  PRODUCTION   // ⚙️ Раскрой / Фрезеровка / Лазер
  ASSEMBLY     // 🔨 Сборка бортов букв / Светодиоды
  INSTALLATION // 🏗️ Монтаж вывески / Автовышка
  HANDOVER     // 🤝 Сдача объекта и подписание акта
  GENERAL      // 📌 Общие дела цеха (ТО, налоги, аренда)
}

model Lead {
  id              String          @id @default(uuid())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  name            String
  phone           String
  message         String?
  calcDetails     String?         // Детали из калькулятора
  status          LeadStatus      @default(NEW)
  rating          ClientRating    @default(STANDARD) // Оценка сложности заказчика
  
  // Новые поля для расширенного CRM
  comment         String?         // Заметки менеджера / примечания
  source          String?         // Источник ("Сайт (Квиз)", "WhatsApp", "Вручную" и т.д.)
  address         String?         // Адрес замера / монтажа
  appointmentDate DateTime?       // Дата замера
  deadline        DateTime?       // Срок сдачи проекта
  manager         PartnerName?    // Ответственный партнер
  
  // Аналитика
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  utmContent      String?
  utmTerm         String?
  yandexClientId  String?
  googleClientId  String?
  fbBrowserId     String?         // fbp/fbc

  // Мягкое удаление и причины отказа
  deletedAt       DateTime?       // Дата мягкого удаления (в корзину)
  rejectionReason String?         // Причина отказа / не отработан

  // Финансы сделки
  offeredPrice    Float?          // Озвученная клиенту стоимость
  isDiscounted    Boolean         @default(false) // Озвучено со скидкой
  revenue         Float           @default(0)
  expenses        Float           @default(0)
  prepayment      Float           @default(0)
  isPrepaymentPaid Boolean        @default(false)
  isBalancePaid    Boolean        @default(false)
  
  transactions    DbTransaction[]
  files           LeadFile[]
  activities      LeadActivity[]
  
  // Связь со сметой/калькулятором себестоимости
  estimate        LeadEstimate?

  // Связь с клиентом
  clientId        String?
  client          Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)

  // Новые связи B2B CRM (Компании, Проекты, Контакты)
  companyId       String?
  company         Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)

  projectId       String?
  project         Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)

  contactId       String?
  contact         Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)

  // Связь с физическими кликами
  clicks          LeadClick[]

  // Задачи производственного цикла
  autoTasksEnabled Boolean        @default(true) // Включена ли автогенерация задач цеха
  tasks           CrmTask[]

  @@index([status, createdAt(sort: Desc)])
  @@index([clientId])
  @@index([companyId])
  @@index([projectId])
  @@index([contactId])
  @@index([manager])
  @@index([phone])
  @@index([deletedAt])
  @@index([createdAt(sort: Desc)])
}

model LeadClick {
  id              String   @id @default(uuid())
  createdAt       DateTime @default(now())
  code            String   @unique // Короткий реферальный код "AD-8492"
  type            String   // "whatsapp" | "phone"
  pageUrl         String?  // Страница захода

  // Аналитика и маркетинг
  gclid           String?  // Google Ads Click ID
  yclid           String?  // Яндекс Директ Click ID
  fbclid          String?  // Meta Click ID
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  utmContent      String?
  utmTerm         String?
  yandexClientId  String?
  googleClientId  String?
  fbBrowserId     String?
  ip              String?
  userAgent       String?

  // Расширенный контекст клика
  deviceType        String?  // Mobile/Desktop/Tablet
  browser           String?  // Chrome/Safari/Firefox/Mobile Safari
  os                String?  // iOS/Android/Windows/macOS
  referrerUrl       String?  // откуда пришел
  timeOnSiteSeconds Int?     // секунд на сайте до клика
  landingPage       String?  // первая страница входа

  // Ручной и авто-матчинг
  status          String   @default("PENDING") // PENDING, MATCHED, EXPIRED
  matchedLeadId   String?
  matchedLead     Lead?    @relation(fields: [matchedLeadId], references: [id], onDelete: SetNull)

  @@index([status, createdAt(sort: Desc)])
  @@index([matchedLeadId])
}

model LeadFile {
  id        String       @id @default(uuid())
  createdAt DateTime     @default(now())
  name      String       // Название файла ("Замер_фасада.jpg")
  url       String       // Прямая ссылка на Cloudflare R2
  fileKey   String       // Ключ в R2 для удаления
  size      Int          // Размер в байтах
  mimeType  String       // image/jpeg, application/pdf и т.д.
  category  FileCategory @default(OTHER)
  
  leadId    String?
  lead      Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([projectId])
}

model LeadActivity {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  text      String   // "Созвонились: обсудили размеры букв, попросил акрил 3мм"
  author    String?  // Даниил / Елисей / Система
  type      String   @default("NOTE") // CALL, NOTE, STATUS_CHANGE, MEETING
  
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt(sort: Desc)])
}

model DbTransaction {
  id              String           @id @default(uuid())
  createdAt       DateTime         @default(now())
  transactionDate DateTime         @default(now())
  type            TransactionType
  amount          Float
  description     String
  
  leadId          String?
  lead            Lead?            @relation(fields: [leadId], references: [id], onDelete: SetNull)
  
  partner         PartnerName?

  accountId       String?
  account         FinanceAccount?  @relation("AccountTransactions", fields: [accountId], references: [id], onDelete: SetNull)

  targetAccountId String?
  targetAccount   FinanceAccount?  @relation("TargetAccountTransactions", fields: [targetAccountId], references: [id], onDelete: SetNull)

  categoryId      String?
  category        FinanceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  receiptUrl      String?

  @@index([leadId])
  @@index([createdAt(sort: Desc)])
  @@index([transactionDate(sort: Desc)])
  @@index([type])
  @@index([accountId])
  @@index([targetAccountId])
  @@index([categoryId])
}

model FinanceAccount {
  id           String          @id @default(uuid())
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  name         String
  type         AccountType     @default(CASH_OFFICE)
  balance      Float           @default(0)
  currency     String          @default("KZT")
  isDefault    Boolean         @default(false)
  color        String          @default("orange")
  icon         String?
  isArchived   Boolean         @default(false)

  transactions DbTransaction[] @relation("AccountTransactions")
  transfersTo  DbTransaction[] @relation("TargetAccountTransactions")

  @@index([type])
  @@index([isArchived])
}

model FinanceCategory {
  id           String            @id @default(uuid())
  name         String
  type         CategoryType
  color        String            @default("slate")
  icon         String?
  parentId     String?
  parent       FinanceCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     FinanceCategory[] @relation("CategoryHierarchy")
  isArchived   Boolean           @default(false)

  transactions DbTransaction[]

  @@index([type])
  @@index([parentId])
}

model CompanyFund {
  id            String   @id @default(uuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  name          String
  targetPercent Float    @default(0) // % от чистой прибыли
  balance       Float    @default(0)
  color         String   @default("blue")
}

model CrmTask {
  id              String        @id @default(uuid())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  title           String        // Название задачи
  description     String?       // Детали, адрес, техзадание
  
  status          TaskStatus    @default(TODO)
  priority        TaskPriority  @default(NORMAL)
  stage           TaskStage     @default(GENERAL)
  
  dueDate         DateTime?     // Срок выполнения (дедлайн)
  completedAt     DateTime?     // Дата фактического закрытия
  
  // Ответственный партнер
  assignee        PartnerName?  // DANIIL / ELISEY
  
  // Связка с заказом цеха
  leadId          String?
  lead            Lead?         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  
  // Автоматически создана системой по шаблону
  isAutoGenerated Boolean       @default(false)
  
  // Ожидаемый и фактический бюджет задачи
  estimatedCost   Float?        // Планируемый расход
  actualCost      Float?        // Фактический расход
  
  // Чек-лист подпунктов
  subtasks        CrmSubtask[]
  
  @@index([status])
  @@index([stage])
  @@index([assignee])
  @@index([dueDate])
  @@index([leadId])
  @@index([status, priority, dueDate])
  @@index([createdAt(sort: Desc)])
}

model CrmSubtask {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  title       String
  isCompleted Boolean  @default(false)
  order       Int      @default(0)
  
  taskId      String
  task        CrmTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  
  @@index([taskId])
}

model CompanyState {
  id          String          @id @default("global")
  cashbox     Float           @default(0) // Баланс кассы фирмы
}

model Client {
  id            String          @id @default(uuid())
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  name          String          // Имя контакта / представителя
  phone         String          @unique // Уникальный телефон клиента
  email         String?
  companyName   String?         // Название организации
  binIin        String?         // БИН или ИИН для документов
  contractNum   String?         // Номер договора
  legalAddress  String?         // Юридический адрес
  bankAccount   String?         // Реквизиты счета / БИК / Банк
  notes         String?         // Общие заметки по работе с клиентом

  leads         Lead[]          // Проекты/сделки этого клиента

  @@index([name])
}

model Company {
  id            String          @id @default(uuid())
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  name          String          // Название компании ("ООО Вектор / ТРЦ Ардагер")
  binIin        String?         // БИН или ИИН компании
  industry      String?         // Сфера деятельности ("Рестораны", "Ритейл", "Строительство")
  legalAddress  String?         // Юр. адрес
  bankAccount   String?         // Реквизиты счета / ИИК / Банк
  rating        ClientRating    @default(STANDARD) // Категория заказчика (EASY, STANDARD, PROBLEM)
  notes         String?         // Общие заметки

  contacts      Contact[]       // Сотрудники / ЛПР компании
  projects      Project[]       // Объекты / крупные проекты компании
  leads         Lead[]          // Заявки и сделки этой компании

  @@index([name])
}

model Contact {
  id              String   @id @default(uuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  name            String   // ФИО контакта ("Иванов Иван")
  position        String?  // Должность ("Маркетолог", "Ген. директор", "Прораб")
  phone           String   // Номер телефона
  email           String?  // Email
  whatsapp        String?  // Ссылка/номер WhatsApp
  isDecisionMaker Boolean  @default(false) // Флаг: ЛПР (Лицо Принимающее Решения)
  notes           String?  // Заметки о контакте

  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  leads           Lead[]   // Заявки, за которые отвечает этот контакт

  @@index([companyId])
  @@index([phone])
}

model Project {
  id          String        @id @default(uuid())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  title       String        // Название ("Оформление сети ресторанов 'Шеф'")
  status      ProjectStatus @default(IN_PROGRESS)
  budget      Float         @default(0) // Суммарный целевой/плановый бюджет
  notes       String?       // Заметки по проекту/объекту

  companyId   String
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  leads       Lead[]        // Заявки / этапы входящие в этот проект
  files       LeadFile[]    // Файлы, чертежи и договора проекта

  @@index([companyId])
  @@index([status])
}

enum InventoryUnit {
  SQUARE_METER  // кв. м.
  RUNNING_METER // пог. м.
  PIECE        // шт.
  ROLL         // рулон
  PACK         // упак.
  LITER        // л.
}

enum EstimateItemType {
  MATERIAL_STOCK    // Материал со склада
  MATERIAL_SUPPLIER // Поставщик (под заказ)
  LOGISTICS         // Газель / Доставка
  EQUIPMENT         // Автовышка / спецтехника
  ASSEMBLY          // Оплата сборщикам
  INSTALLATION      // Оплата монтажникам
  CUSTOM            // Прочее (вручную)
}

model WarehouseItem {
  id           String                 @id @default(uuid())
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  name         String                 @unique
  category     String                 // "Пластики", "Светодиоды", "Профили", "Пленки" и т.д.
  quantity     Float                  @default(0)
  unit         InventoryUnit
  price        Float                  @default(0) // Себестоимость за ед.
  location     String?                // Примечание по месту хранения
  minStock     Float                  @default(0) // Минимальный порог (для алертов)

  transactions WarehouseTransaction[]

  @@index([category])
}

model WarehouseTransaction {
  id              String         @id @default(uuid())
  createdAt       DateTime       @default(now())
  itemId          String
  item            WarehouseItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantityChanged Float          // Положительное (приход) или отрицательное (списание)
  description     String?        // "Списание под лид №123", "Поступление от поставщика"
  leadId          String?        // Связь с лидом, если списание под проект

  @@index([itemId, createdAt(sort: Desc)])
  @@index([leadId])
}

model Supplier {
  id        String          @id @default(uuid())
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  name      String          @unique // Название поставщика (напр. "Демер")
  address   String?         // Адрес офиса/склада
  phone     String?         // Телефонный номер (основной)
  phones    String[]        @default([]) // Список телефонных номеров
  whatsapp  String?         // Ссылка на WhatsApp (напр. https://wa.me/...)
  website   String?         // Веб-сайт поставщика
  instagram String?         // Instagram профиль
  notes     String?         // Заметки, контакты менеджеров и др.
  prices    SupplierPrice[]
}

model SupplierPrice {
  id          String        @id @default(uuid())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  name        String        // Название материала/услуги
  supplier    String        // Поставщик (текстовое имя для совместимости)
  price       Float         // Цена за единицу
  unit        InventoryUnit
  category    String?       // Категория (напр. "Листовые материалы", "Светотехника", "Перезаказ услуг")
  subcategory String?       // Подкатегория (напр. "Листовой акрил", "Вспененный ПВХ", "Алюмокомпозит")
  imageUrl    String?       // Фотография материала для наглядности
  description String?       // Описание, спецификация, размеры
  sourceUrl   String?       // Ссылка на товар у поставщика (signtech.kz и т.д.)
  isService   Boolean       @default(false) // Является ли перезаказом услуги (фрезеровка, лазер, печать)
  isFavorite  Boolean       @default(false) // Избранный / часто закупаемый товар
  
  supplierId  String?
  supplierObj Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([supplierId])
  @@index([name])
  @@index([category])
  @@index([subcategory])
  @@index([isFavorite])
  @@index([isService])
}

model LeadEstimate {
  id        String         @id @default(uuid())
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  leadId    String?        @unique
  lead      Lead?          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  items     EstimateItem[]
  
  // Флаг, списывались ли уже материалы со склада под эту смету
  isStockDeducted Boolean  @default(false)
}

model EstimateItem {
  id         String           @id @default(uuid())
  estimateId String
  estimate   LeadEstimate     @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  type       EstimateItemType
  name       String           // "Акрил 3мм молочный", "Работа монтажников"
  quantity   Float            @default(1)
  unit       InventoryUnit?
  costPrice  Float            @default(0) // Себестоимость за ед.
  sellPrice  Float            @default(0) // Цена для продажи клиенту за ед.
  
  // Для связи со складом при ручном списании
  warehouseItemId String?
  supplierPriceId String?

  @@index([estimateId])
  @@index([warehouseItemId])
  @@index([supplierPriceId])
}

enum UserRole {
  ADMIN     // Главный администратор (Даниил / Елисей) — полный доступ
  MANAGER   // Менеджер по продажам — работа с лидами и клиентами (без управления финансами компании)
  WORKER    // Цех / Монтажник — просмотр эскизов, чертежей и заказов в работе
}

model UserProfile {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  email     String   @unique
  name      String   // ФИО сотрудника
  role      UserRole @default(MANAGER)
  phone     String?
}

model WorkOperation {
  id           String           @id @default(uuid())
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  type         EstimateItemType // ASSEMBLY или INSTALLATION
  name         String           @unique // "Сборка лайтбокса", "Сварка кронштейна", "Закатка пленки", "Монтаж вывески", "Демонтаж"
  unit         InventoryUnit    @default(PIECE)
  defaultCost  Float            @default(0) // Оплата рабочим / себестоимость
  defaultPrice Float            @default(0) // Цена для клиента
  isCustom     Boolean          @default(false)
}

model EstimatePreset {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  name        String   // Название шаблона (напр. "Лайтбокс 2×1м", "Объемные буквы 30см")
  category    String?  // Категория ("Лайтбоксы", "Буквы", "Вывески", "Неон", "Монтаж")
  description String?  // Краткая подсказка по расходу/составу
  items       Json     // Array<{ type, name, quantity, unit, costPrice, sellPrice, supplierPriceId, warehouseItemId }>
  isFavorite  Boolean  @default(false)

  @@index([category])
  @@index([isFavorite])
}

// ── Обучаемый интеллектуальный поиск (CRM + Будущий сайт) ─────────────

model SearchQueryLog {
  id            String   @id @default(uuid())
  createdAt     DateTime @default(now())
  query         String
  normalized    String
  context       String   @default("global") // "calculator", "pricing", "leads", "site"
  resultsCount  Int      @default(0)
  selectedId    String?  // ID выбранного элемента (клик)
  selectedTitle String?  // Название выбранного элемента
  userId        String?

  @@index([normalized])
  @@index([context])
  @@index([createdAt])
}

model SearchSynonymRule {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  word        String   @unique // Слово, которое ищут (например "дибонд")
  synonyms    String[] // Синонимы (["акп", "композит", "дибонд"])
  description String?  // Описание
  isActive    Boolean  @default(true)

  @@index([word])
}

model SearchClickWeight {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  queryNorm  String   // Нормализованный запрос (например "пвх 5")
  entityType String   // "supplier_price", "preset", "lead", "product"
  entityId   String   // ID выбранной сущности
  clickCount Int      @default(1) // Количество выборов менеджерами или клиентами

  @@unique([queryNorm, entityId])
  @@index([queryNorm])
  @@index([entityId])
}


